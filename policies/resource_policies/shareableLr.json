{
  "@context": [
    "http://www.w3.org/ns/odrl.jsonld",
    {
      "ex":   "http://example.com/ns#",
      "xsd":  "http://www.w3.org/2001/XMLSchema#",
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "output": {
        "@id":   "http://example.com/ns#output",
        "@type": "@id"
      },
      "consequence": {
        "@id":        "http://www.w3.org/ns/odrl/2/consequence",
        "@type":      "@id",
        "@container": "@set"
      }
    }
  ],
  "@type": "Offer",
  "@id":   "http://example.com/RP_lri/consumePolicy:001",
  "profile": { "@id": "http://example.com/resourceProfile:ShareableLimitedBR" },
  "permission": [
    {
      "target":   { "@id": "http://example.com/resources/R_slri/states/MadeAvailable/" },
      "assigner": { "@id": "http://example.com/resources/R_slriOwner" },
      "action":   { "@id": "odrl:use" },
      "output":   { "@id": "http://example.com/resources/R_slri/states/NotConsumed/" }
    },
    {
      "target":   { "@id": "http://example.com/resources/R_slri/states/NotConsumed/" },
      "assigner": { "@id": "http://example.com/resources/R_slriOwner" },
      "action": [
        { "@id": "odrl:use" },
        { "@id": "odrl:concurrentUse" }
      ],
      "output": { "@id": "http://example.com/resources/R_slri/states/Consumed/" }
    },
    {
      "target": { "@id": "http://example.com/resources/R_slri/states/Consumed/" },
      "action": { "@id": "odrl:use" },
      "output": { "@id": "http://example.com/resources/R_slri/states/Done/" }
    }
  ],
  "obligation": [
    {
      "target":   { "@id": "http://example.com/resources/R_slri/states/Done/" },
      "assigner": { "@id": "http://example.com/resources/R_slriOwner" },
      "action":   { "@id": "odrl:use" },
      "output":   { "@id": "http://example.com/resources/R_slri/states/MadeAvailable/" },
      "consequence": [
        {
          "assigner": { "@id": "http://example.com/resources/R_slriOwner" },
          "action":   { "@id": "odrl:use" },
          "output":   { "@id": "http://example.com/resources/R_slri/states/Withdrawn/" }
        }
      ]
    }
  ]
}