{
  "@context": [
    "http://www.w3.org/ns/odrl.jsonld",
    {
      "ex":   "http://example.com/ns#",
      "xsd":  "http://www.w3.org/2001/XMLSchema#",
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "output": {
        "@id":   "http://example.com/ns#output",
        "@type": "@id"
      },
      "consequence": {
        "@id":        "http://www.w3.org/ns/odrl/2/consequence",
        "@type":      "@id",
        "@container": "@set"
      }
    }
  ],
  "@type": "Offer",
  "@id":   "http://example.com/RP_suli/consumePolicy:002",
  "profile": { "@id": "http://example.com/resourceProfile:ShareableUnlimited" },
  "permission": [
    {
      "@id":    "http://example.com/rules/shareableUnlimitedR/R_suli",
      "target":   { "@id": "http://example.com/resources/R_suli/states/NotConsumed/" },
      "assigner": { "@id": "http://example.com/resources/R_suliOwner" },
      "action": [
        { "@id": "odrl:use" },
        { "@id": "odrl:concurrentUse" }
      ],
      "output": { "@id": "http://example.com/resources/R_suli/states/Consumed/" },
      "duty": [
        {
          "target": { "@id": "http://example.com/resources/R_suli/states/Consumed/" },
          "action": { "@id": "odrl:use" },
          "output": { "@id": "http://example.com/resources/R_suli/states/Withdrawn/" },
          "constraint": [
            {
              "leftOperand":  { "@id": "odrl:event" },
              "operator":     { "@id": "odrl:gt" },
              "rightOperand": { "@id": "odrl:policyUsage" }
            }
          ]
        }
      ]
    }
  ]
}