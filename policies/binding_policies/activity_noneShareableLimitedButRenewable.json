{
  "@context": [
    "http://www.w3.org/ns/odrl.jsonld",
    {
      "rdf":   "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "rdfs":  "http://www.w3.org/2000/01/rdf-schema#",
      "xsd":   "http://www.w3.org/2001/XMLSchema#",
      "ex":    "http://example.com/ns#",
      "output": {
        "@id":   "http://example.com/ns#output",
        "@type": "@id"
      }
    }
  ],
  "@type": "Request",
  "@id":   "http://example.com/IPlrRiAi:004",
  "profile": { "@id": "http://example.com/activityProfile:NonShareableLimitedBR" },

  "permission": [
    {
      "@id":      "http://example.com/rules/IPlriairule1",
      "target":   { "@id": "http://example.com/resources/nsR_lri/states/Consumed/" },
      "assignee": { "@id": "http://example.com/activity/Ai/states/Activated" },
      "output":   { "@id": "http://example.com/resources/nsR_lri/states/Done/" },
      "action": [
        {
          "rdf:value": { "@id": "odrl:use" },
          "refinement": [
            {
              "leftOperand":  { "@id": "odrl:elapsedTime" },
              "operator":     { "@id": "odrl:lteq" },
              "rightOperand": { "@value": "PXM", "@type": "xsd:duration" },
              "rdfs:comment": "Accumulated metered time periods must not exceed X minutes"
            }
          ]
        }
      ],
      "duty": [
        {
          "action": { "@id": "odrl:use" },
          "rdfs:comment": "Ensure exclusive (non-shared) access during consumption",
          "constraint": [
            {
              "leftOperand":  { "@id": "odrl:event" },
              "operator":     { "@id": "odrl:lt" },
              "rightOperand": { "@id": "odrl:policyUsage" }
            }
          ]
        }
      ]
    }
  ]
}