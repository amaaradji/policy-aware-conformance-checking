{
  "@context": [
    "http://www.w3.org/ns/odrl.jsonld",
    {
      "ex":   "http://example.com/ns#",
      "xsd":  "http://www.w3.org/2001/XMLSchema#",
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "output": {
        "@id":   "http://example.com/ns#output",
        "@type": "@id"
      },
      "consequence": {
        "@id":        "http://www.w3.org/ns/odrl/2/consequence",
        "@type":      "@id",
        "@container": "@set"
      }
    }
  ],

  "@graph": [
    {
      "@type":   "Offer",
      "@id":     "http://example.com/AP_ret/ActivatedAPi",
      "profile": { "@id": "http://example.com/activityProfile:Retriable" },
      "inheritFrom": { "@id": "http://example.com/failureAP:005" },

      "permission": [
        {
          "assigner": { "@id": "http://example.com/owners/Ai" },
          "target":   { "@id": "http://example.com/activity/Ai/states/NotActivated" },
          "action":   { "@id": "odrl:use" },
          "output":   { "@id": "http://example.com/activity/Ai/states/Activated" }
        }
      ],

      "obligation": [
        {
          "assigner": { "@id": "http://example.com/owners/Ai" },
          "target":   { "@id": "http://example.com/activity/Ai/states/Activated" },
          "action":   { "@id": "odrl:use" },
          "output":   { "@id": "http://example.com/activity/Ai/states/Done" },
          "consequence": [
            {
              "@id": "http://example.com/failureAP:005"
            }
          ]
        }
      ]
    },

    {
      "@type":   "Offer",
      "@id":     "http://example.com/failureAP:005",
      "profile": { "@id": "http://example.com/activityProfile:Retriable:failure" },

      "obligation": [
        {
          "assigner": { "@id": "http://example.com/owners/Ai" },
          "target":   { "@id": "http://example.com/activity/Ai/states/Activated" },
          "action":   { "@id": "odrl:use" },
          "output":   { "@id": "http://example.com/activity/Ai/states/Failed" },

          "constraint": [
            {
              "leftOperand":  { "@id": "odrl:count" },
              "operator":     { "@id": "odrl:lteq" },
              "rightOperand": {
                "@value": "3",
                "@type":  "xsd:integer"
              },
              "rdfs:comment": "Replace 3 with your actual maximum retry count X"
            }
          ],

          "duty": [
            {
              "action": { "@id": "odrl:use" },
              "output": { "@id": "http://example.com/activity/Ai/states/Activated" },
              "constraint": [
                {
                  "leftOperand":  { "@id": "odrl:event" },
                  "operator":     { "@id": "odrl:gt" },
                  "rightOperand": { "@id": "odrl:policyUsage" }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}