<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_15" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.43.1">
  <bpmn:process id="Process_Onboarding" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
    <bpmn:task id="Activity_Collect" name="Collect Customer Info">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AND_Split">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ID</bpmn:outgoing>
      <bpmn:outgoing>Flow_Credit</bpmn:outgoing>
      </bpmn:parallelGateway>
    <bpmn:task id="Activity_Verify" name="Verify ID">
      <bpmn:incoming>Flow_ID</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
      </bpmn:task>
    <bpmn:task id="Activity_Check" name="Check Credit Score">
      <bpmn:incoming>Flow_Credit</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
      <bpmn:outgoing>Flow_0zlzgsa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AND_Join">
      <bpmn:incoming>Flow_Join</bpmn:incoming>
      <bpmn:incoming>Flow_0zlzgsa</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Risk Level?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualReview</bpmn:outgoing>
      </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_AutoApprove" name="Auto Approve">
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_1ne7b03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_ManualReview" name="Manual Review">
      <bpmn:incoming>Flow_ManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_1ki9jp9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Activate" name="Activate Account">
      <bpmn:incoming>Flow_1bvjdal</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:task>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_Collect"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Collect" targetRef="Gateway_AND_Split"/>
    <bpmn:sequenceFlow id="Flow_ID" sourceRef="Gateway_AND_Split" targetRef="Activity_Verify"/>
    <bpmn:sequenceFlow id="Flow_Credit" sourceRef="Gateway_AND_Split" targetRef="Activity_Check"/>
    <bpmn:sequenceFlow id="Flow_Join" sourceRef="Activity_Verify" targetRef="Gateway_AND_Join"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_AND_Join" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_AutoApprove" sourceRef="Gateway_Decision" targetRef="Activity_AutoApprove"/>
    <bpmn:sequenceFlow id="Flow_ManualReview" sourceRef="Gateway_Decision" targetRef="Activity_ManualReview"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Activate" targetRef="EndEvent_1"/>
    <bpmn:exclusiveGateway id="Gateway_00569pf" name="auto/manual">
      <bpmn:incoming>Flow_1ne7b03</bpmn:incoming>
      <bpmn:incoming>Flow_1ki9jp9</bpmn:incoming>
      <bpmn:outgoing>Flow_1bvjdal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ne7b03" sourceRef="Activity_AutoApprove" targetRef="Gateway_00569pf"/>
    <bpmn:sequenceFlow id="Flow_1ki9jp9" sourceRef="Activity_ManualReview" targetRef="Gateway_00569pf"/>
    <bpmn:sequenceFlow id="Flow_1bvjdal" sourceRef="Gateway_00569pf" targetRef="Activity_Activate"/>
    <bpmn:sequenceFlow id="Flow_0zlzgsa" sourceRef="Activity_Check" targetRef="Gateway_AND_Join"/>
    </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Onboarding">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
