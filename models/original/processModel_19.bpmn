<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_19" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.43.1">
  <bpmn:process id="Process_DocSignoff" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
    <bpmn:task id="Activity_Prepare" name="Prepare Document">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AND_Split">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tech</bpmn:outgoing>
      </bpmn:parallelGateway>
    <bpmn:task id="Activity_Legal" name="Legal Review">
      <bpmn:incoming>Flow_Legal</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
      </bpmn:task>
    <bpmn:task id="Activity_Tech" name="Technical Review">
      <bpmn:incoming>Flow_Tech</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
      <bpmn:outgoing>Flow_0yphjfu</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AND_Join">
      <bpmn:incoming>Flow_Join</bpmn:incoming>
      <bpmn:incoming>Flow_0yphjfu</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:parallelGateway>
    <bpmn:task id="Activity_Finalize" name="Finalize Document">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:task>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_Prepare"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Prepare" targetRef="Gateway_AND_Split"/>
    <bpmn:sequenceFlow id="Flow_Legal" sourceRef="Gateway_AND_Split" targetRef="Activity_Legal"/>
    <bpmn:sequenceFlow id="Flow_Tech" sourceRef="Gateway_AND_Split" targetRef="Activity_Tech"/>
    <bpmn:sequenceFlow id="Flow_Join" sourceRef="Activity_Legal" targetRef="Gateway_AND_Join"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_AND_Join" targetRef="Activity_Finalize"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Finalize" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="Flow_0yphjfu" sourceRef="Activity_Tech" targetRef="Gateway_AND_Join"/>
    </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
