      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
    <bpmn:task id="Activity_Inspect" name="Inspect Product">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Pass Quality?">
