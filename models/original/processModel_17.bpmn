    <bpmn:sequenceFlow id="Flow_0j7lqvt" sourceRef="Activity_Ship" targetRef="Gateway_0izvmxj"/>
    <bpmn:sequenceFlow id="Flow_1ofqcd5" sourceRef="Activity_Rework" targetRef="Gateway_0izvmxj"/>
    <bpmn:sequenceFlow id="Flow_0h301q9" sourceRef="Gateway_0izvmxj" targetRef="EndEvent_1"/>
