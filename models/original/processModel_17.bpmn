      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
      </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_Ship" name="Ship Product">
