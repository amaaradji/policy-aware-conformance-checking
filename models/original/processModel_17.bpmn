    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_Inspect"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Inspect" targetRef="Gateway_Decision"/>
