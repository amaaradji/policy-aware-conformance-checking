      "output": {
        "@id":   "http://example.com/ns#output",
        "@type": "@id"
      },
      "consequence": {
        "@id":        "http://www.w3.org/ns/odrl/2/consequence",
        "@type":      "@id",
        "@container": "@set"
      }
    }
  ],
  "@type": "Offer",
  "@id":   "http://example.com/AP_cps/cpsCP:002",
  "profile": { "@id": "http://example.com/activityProfile:Compensatable" },

  "permission": [
    {
      "assigner": { "@id": "http://example.com/owners/Ai" },
      "target":   { "@id": "http://example.com/activity/Ai/states/NotActivated" },
      "action":   { "@id": "odrl:use" },
      "output":   { "@id": "http://example.com/activity/Ai/states/Activated" }
    },
    {
      "assigner": { "@id": "http://example.com/owners/Ai" },
      "target":   { "@id": "http://example.com/activity/Ai/states/Done" },
      "action":   { "@id": "odrl:use" },
      "output":   { "@id": "http://example.com/activity/Ai/states/Compensated" }
    }
  ],

  "obligation": [
    {
      "assigner": { "@id": "http://example.com/owners/Ai" },
      "target":   { "@id": "http://example.com/activity/Ai/states/Activated" },
      "action":   { "@id": "odrl:use" },
      "output":   { "@id": "http://example.com/activity/Ai/states/Done" },
      "consequence": [
        {
          "action": { "@id": "odrl:use" },
          "output": { "@id": "http://example.com/activity/Ai/states/Failed" }
        }
      ]
